---
interface Props {
    label: string;
    appearFrom: 'right' | 'left' | 'top';
}

const { label, appearFrom } = Astro.props as Props;

const classForAppearanceTransition = {
    right: '[--card-start-transform:translate(5px,0px)]',
    left:  '[--card-start-transform:translate(-5px,0px)]',
    top:   '[--card-start-transform:translate(0px,-5px)]'
}[appearFrom];
---

<!-- target.classList.add('opacity-100', '!translate-x-0', '!translate-y-0'); -->

<div class={`card-item flex flex-col items-center gap-6 animate-card-appear ${classForAppearanceTransition}`}>
    <slot/>
    <span set:html={label} class="text-xl lg:text-2xl text-center text-primary" />
</div>